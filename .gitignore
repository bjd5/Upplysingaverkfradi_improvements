# Leyndarmál — ALDREI í git (regla 4)
.env
.env.*
!.env.example
*.key
config/secrets*

# Gögn — afleidd eða of stór (reglur 5 og 7)
data/db/
data/raw/*
# Undanþága (P0.1, issue #30): mbl-eintakið er EINA eintakið sem til er —
# hráa svarið var aldrei í git og hverfur með vélinni sé það ekki fryst hér.
!data/raw/mbl/
# Undanþágur (P0.3, issue #2): frystu hrágögnin. Þau eru FRUMGAGN og ekki
# afleiða — grunninn á að vera hægt að endurbyggja úr þeim án nets (regla 5).
# Söfnin eru lítil (undir 0,3 MB samtals) og eiga því heima í git.
!data/raw/vedur-quakes/
!data/raw/hagstofan/
!data/raw/vedurstodvar/
!data/raw/README.md
!data/raw/frysting.json
# Undanþága (issue #3, ákvörðun a, 28.9.2026): Friends-handritin eru skráð
# sem git SUBMODULE á data/raw/friends-handrit. Undanþágan opnar aðeins
# gitlink-færsluna (mode 160000) — slóð og commit-SHA, engan texta. Git fer
# aldrei inn í submodule-möppuna eftir skrám, svo handritin sjálf komast ekki
# í þetta repo þótt þau séu sótt með `git submodule update --init`.
# Ákvörðunin: docs/adferdafraedi.md, kafli 1.5.1; uppruni: docs/heimildir.md, 2.1.
!data/raw/friends-handrit
data/processed/*
!data/processed/README.md
# Undanþága (issue #3, valkostur A): Friends-tölfræðin. Þetta eru tölur UM
# handritin — línufjöldi, senur, hlutföll, tíðnitöflur — ekki handritstextinn.
# Handritin sjálf eru hvergi í þessu repo-i og koma aldrei hingað. Skrárnar eru
# frosna viðmiðið (SHA-256 í docs/vidmid/provenance.json) og eina eftirlifandi
# eintakið af greiningunni, svo þær eru FRUMGAGN fyrir þetta repo (regla 5).
# Sjá data/processed/README.md og docs/adferdafraedi.md, kafla 1.5.1.
!data/processed/phoebe-stats/
# Undanþága (issue #10, valkostur A): frosnu Central Perk-niðurstöðurnar —
# bætaeins afrit þriggja skráa úr docs/vidmid/generated/, sama röksemd og að
# ofan. Sjá data/processed/README.md, kafla 2.
!data/processed/central-perk-frosid/

*.sqlite
*.sqlite3
*.db

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# C++
build/
*.o
*.out

# Java
target/
*.class
*.jar

# Ritlar og stýrikerfi
.idea/
.vscode/
.DS_Store

# Prófunarafurðir
.playwright-mcp/
*.png
!web/assets/img/*.png
# Undanþága (P0.1, issue #30): myndir byggðu gömlu síðunnar eru hluti af
# frosna viðmiðinu og mega ekki týnast úr því.
!docs/vidmid/vefur/**/*.png
