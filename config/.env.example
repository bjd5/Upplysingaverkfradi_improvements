# Afritaðu í .env og fylltu út. .env fer ALDREI í git (regla 4).
# Raunveruleg umhverfisbreyta gengur fyrir gildi hér (src/python/sofnun/stillingar.py).

# Tengiliður í User-Agent — skylda þegar sótt er af netinu (regla 4)
NOTANDA_AUDKENNI=upplysingaverkfraedi-rannsokn (bjd5@hi.is)

# Hraðatakmörkun gagnvart vefþjónustunni — sekúndur milli kalla (regla 4)
BID_MILLI_KALLA=1.0

# Lykill TMDB (Bearer). Vanti hann er safnið skráð óvirkt (issue #75).
TMDB_TOKEN=

# Aðeins lesnar úr umhverfinu, ekki úr .env:
#   RANNSOKN_GRUNNUR       slóð grunnsins (sjálfgefið data/db/rannsokn.sqlite)
#   FRIENDS_HANDRIT_MAPPA  mappan season/ með Friends-handritunum (sjá README)
